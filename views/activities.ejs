<%- include('partials/head') %>
<%- include('partials/navbar') %>
<%- include('partials/flash') %>

<div class="page-container">
    <h1>Activities</h1>
    <p class="section-subtitle" style="text-align: left; margin-bottom: 30px;">Track your work tasks and hobby time.</p>

    <div class="form-container" style="margin: 0 0 40px 0; max-width: 100%;">
        <h2>Add an activity</h2>

        <form action="/activities" method="POST">
            <div class="form-group">
                <label for="title">Title</label>
                <input type="text" id="title" name="title" placeholder="e.g. Finished report, Practiced guitar" required>
            </div>

            <div class="form-group">
                <label for="category">Category</label>
                <select id="category" name="category" required>
                    <option value="work">Work</option>
                    <option value="hobby">Hobby</option>
                </select>
            </div>

            <div class="form-group">
                <label for="duration_minutes">Duration (minutes)</label>
                <input type="number" id="duration_minutes" name="duration_minutes" min="1" required>
            </div>

            <div class="form-group">
                <label for="logged_at">Date & time</label>
                <input type="datetime-local" id="logged_at" name="logged_at" required>
            </div>

            <div class="form-group">
                <label for="notes">Notes (optional)</label>
                <textarea id="notes" name="notes" rows="2" placeholder="What did you accomplish?"></textarea>
            </div>

            <button type="submit" class="btn">Add activity</button>
        </form>
    </div>

    <div class="entry-list">
        <% if (activities.length === 0) { %>
            <p style="color: #777;">No activities logged yet. Add your first one above.</p>
        <% } else { %>
            <% activities.forEach(function(a) { %>
                <div class="entry-card">
                    <div class="entry-details">
                        <h3><%= a.title %> <span style="color:#999; font-weight: 400;">(<%= a.category %>)</span></h3>
                        <p><%= new Date(a.logged_at).toLocaleString() %> · <%= a.duration_minutes %> min</p>
                        <% if (a.notes) { %><p><%= a.notes %></p><% } %>
                    </div>
                    <form action="/activities/<%= a.id %>/delete" method="POST">
                        <button type="submit" class="delete-btn">Delete</button>
                    </form>
                </div>
            <% }); %>
        <% } %>
    </div>
</div>

<%- include('partials/footer') %>