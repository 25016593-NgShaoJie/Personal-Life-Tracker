<%- include('partials/head') %>
<%- include('partials/navbar') %>
<%- include('partials/flash') %>

<div class="page-container">
    <h1>Sleep</h1>
    <p class="section-subtitle" style="text-align: left; margin-bottom: 30px;">Track your bedtime, wake time, and how rested you feel.</p>

    <div class="form-container" style="margin: 0 0 40px 0; max-width: 100%;">
        <h2>Log your sleep</h2>

        <form action="/sleep" method="POST">
            <div class="form-group">
                <label for="bedtime">Bedtime</label>
                <input type="datetime-local" id="bedtime" name="bedtime" required>
            </div>

            <div class="form-group">
                <label for="wake_time">Wake time</label>
                <input type="datetime-local" id="wake_time" name="wake_time" required>
            </div>

            <div class="form-group">
                <label for="quality_rating">Sleep quality (1–5, optional)</label>
                <input type="number" id="quality_rating" name="quality_rating" min="1" max="5">
            </div>

            <button type="submit" class="btn">Add sleep entry</button>
        </form>
    </div>

    <div class="entry-list">
        <% if (sleeps.length === 0) { %>
            <p style="color: #777;">No sleep logged yet. Add your first entry above.</p>
        <% } else { %>
            <% sleeps.forEach(function(s) { %>
                <% const durationMs = new Date(s.wake_time) - new Date(s.bedtime);
                   const hours = Math.floor(durationMs / (1000 * 60 * 60));
                   const minutes = Math.floor((durationMs % (1000 * 60 * 60)) / (1000 * 60)); %>
                <div class="entry-card">
                    <div class="entry-details">
                        <h3><%= hours %>h <%= minutes %>m of sleep</h3>
                        <p><%= new Date(s.bedtime).toLocaleString() %> → <%= new Date(s.wake_time).toLocaleString() %></p>
                        <% if (s.quality_rating) { %><p>Quality: <%= s.quality_rating %>/5</p><% } %>
                    </div>
                    <form action="/sleep/<%= s.id %>/delete" method="POST">
                        <button type="submit" class="delete-btn">Delete</button>
                    </form>
                </div>
            <% }); %>
        <% } %>
    </div>
</div>

<%- include('partials/footer') %>